{
  "name": "bigo-complexity-analyzer",
  "displayName": "Big-O Complexity Analyzer",
  "description": "Inline time and space complexity (Big-O) analysis for JavaScript and TypeScript files using the TypeScript AST.",
  "version": "1.1.1",
  "publisher": "Ockersz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ockersz/bigo-complexity-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/Ockersz/bigo-complexity-analyzer/issues"
  },
  "homepage": "https://github.com/Ockersz/bigo-complexity-analyzer#readme",
  "keywords": [
    "big-o",
    "time complexity",
    "space complexity",
    "complexity analyzer",
    "typescript",
    "javascript",
    "ast",
    "performance",
    "codelens",
    "algorithms"
  ],
  "galleryBanner": {
    "color": "#1E1E2E",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bigoAnalyzer.revealBottleneck",
        "title": "Big-O: Jump to Bottleneck"
      },
      {
        "command": "bigoAnalyzer.toggleEnabled",
        "title": "Big-O: Toggle Complexity Annotations"
      },
      {
        "command": "bigoAnalyzer.openDashboard",
        "title": "Big-O: Open Complexity Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "bigoAnalyzer.scanWorkspace",
        "title": "Big-O: Scan Workspace Hotspots",
        "icon": "$(search)"
      },
      {
        "command": "bigoAnalyzer.openWalkthrough",
        "title": "Big-O: Open Getting Started Walkthrough"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bigoAnalyzer.openDashboard",
          "group": "navigation",
          "when": "resourceLangId == typescript || resourceLangId == typescriptreact || resourceLangId == javascript || resourceLangId == javascriptreact"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "bigo.gettingStarted",
        "title": "Big-O Complexity Analyzer",
        "description": "See Time & Space Complexity inline, explore the interactive growth chart, and scan your workspace for hotspots.",
        "steps": [
          {
            "id": "bigo.inline",
            "title": "See Inline Complexity & Hover Tips",
            "description": "Open any JS or TS file to view CodeLens summaries above functions, hover breakdowns, and worst-bottleneck highlights.",
            "media": {
              "markdown": "walkthrough/inline.md"
            }
          },
          {
            "id": "bigo.dashboard",
            "title": "Open the Interactive Big-O Dashboard",
            "description": "Click the graph icon in the top-right editor toolbar, click the bottom-right Status Bar item, or use the button below.",
            "media": {
              "markdown": "walkthrough/dashboard.md"
            }
          },
          {
            "id": "bigo.workspace",
            "title": "Scan Your Workspace for Hotspots",
            "description": "Audit every JS/TS file in your repository worst-first and jump directly to nested loops or hidden O(n²) traps.",
            "media": {
              "markdown": "walkthrough/workspace.md"
            }
          },
          {
            "id": "bigo.quickfixes",
            "title": "Suppress with // bigo-ignore & Customize Thresholds",
            "description": "Press Ctrl+. on any diagnostic for one-click Quick Fixes or tune when 🔥 hotspots trigger.",
            "media": {
              "markdown": "walkthrough/quickfixes.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Big-O Complexity Analyzer",
      "properties": {
        "bigoAnalyzer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline time and space complexity analysis."
        },
        "bigoAnalyzer.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Display CodeLens complexity summaries above functions."
        },
        "bigoAnalyzer.showDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the worst-case bottleneck line in the active editor."
        },
        "bigoAnalyzer.hotspotThreshold": {
          "type": "string",
          "enum": [
            "O(n log n)",
            "O(n²)",
            "O(2^n)"
          ],
          "default": "O(n²)",
          "description": "Minimum complexity level flagged as a hotspot (🔥)."
        },
        "bigoAnalyzer.showDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Report hotspot functions in the VS Code Problems panel."
        },
        "bigoAnalyzer.diagnosticSeverity": {
          "type": "string",
          "enum": [
            "Hint",
            "Information",
            "Warning"
          ],
          "default": "Information",
          "description": "Severity level for hotspot diagnostics."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "package:vsix": "npm run package && npx --yes @vscode/vsce package",
    "vscode:prepublish": "npm run package",
    "test": "node -e \"require('esbuild').buildSync({entryPoints:['src/analyzer.test.ts'],bundle:true,platform:'node',format:'cjs',outfile:'dist-test/analyzer.test.js'})\" && node --test dist-test/analyzer.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
